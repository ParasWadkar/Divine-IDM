{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divine IDM",
  "version": "0.1.1",
  "identifier": "local.divine.idm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Divine IDM",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Divine",
    "shortDescription": "A fast, resumable download manager.",
    "longDescription": "Divine IDM downloads files over many connections at once, resumes after a crash or reboot, and takes over downloads from any browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/idm.exe": "idm.exe",
      "../../target/release/idm-host.exe": "idm-host.exe",
      "../../extension/dist/chromium/": "extension/chromium/",
      "../../extension/dist/firefox/": "extension/firefox/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "DivineIDM.Torrent",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent"
      }
    ]
  }
}
