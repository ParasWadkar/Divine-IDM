{
  "manifest_version": 3,
  "name": "DivinePulse",
  "version": "0.1.1",
  "description": "Hands large downloads to DivinePulse for parallel, resumable downloading.",
  "browser_specific_settings": {
    "gecko": {
      "id": "idm@divine.local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DivinePulse"
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_permissions": [
    "cookies",
    "<all_urls>"
  ]
}
